# Required
ONTO_DATABASE_URL=postgresql+asyncpg://onto:onto@postgres:5432/onto
ONTO_SECRET_KEY=replace-with-44-char-base64-fernet-key

# Optional (defaults shown)
ONTO_BIND_HOST=0.0.0.0
ONTO_BIND_PORT=8080
ONTO_LOG_LEVEL=info

ONTO_QUERY_DEFAULT_MAX_ROWS=1000
ONTO_QUERY_MAX_ROWS_CAP=10000
ONTO_QUERY_DEFAULT_TIMEOUT_MS=30000
ONTO_QUERY_TIMEOUT_MS_CAP=120000

ONTO_UI_SESSION_TTL_SECONDS=43200
ONTO_UI_COOKIE_SECURE=true

ONTO_INGESTION_MAX_CONCURRENT=2
ONTO_INGESTION_MAX_UPLOAD_BYTES=25000000
ONTO_INGESTION_MAX_FILES_PER_JOB=20
ONTO_INGESTION_MAX_TOTAL_BYTES_PER_JOB=100000000
ONTO_INGESTION_JOB_WALL_CLOCK_TIMEOUT_S=1800

# Plan #2 (ingestion) reads these
ONTO_LLM_PROVIDER=openai_compat
ONTO_LLM_BASE_URL=
ONTO_LLM_API_KEY=
ONTO_LLM_MODEL=
ONTO_LLM_MAX_STEPS=50
ONTO_LLM_REQUEST_TIMEOUT_S=120
